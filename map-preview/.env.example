# Basemap PMTiles. Relative path (Vite-served static file) or absolute URL,
# e.g. http://localhost:8080/shikoku-basemap.pmtiles
VITE_BASEMAP_URL=/data/shikoku-basemap.pmtiles

# Henro GeoJSON sources (relative to Vite public/ or absolute URLs)
VITE_TEMPLES_URL=/data/temples.geojson

# Henro PMTiles (henro_routes vector layer). Empty to disable.
VITE_HENRO_URL=/data/shikoku-henro.pmtiles

# Shikoku Nature Trail PMTiles (shikoku_nature_trail vector layer). Empty to disable.
VITE_TRAIL_URL=/data/shikoku-nature-trail.pmtiles

# Shikoku Nature Trail route index GeoJSON (for the per-route selector tree).
# Same route_id/name/pref/kind as the PMTiles features. Empty to disable selector.
VITE_TRAIL_LIST_URL=/data/shikoku-nature-trail.geojson

# Provider-specific lodging PMTiles. Both contain the `lodging` vector layer.
# Empty either URL to disable that provider.
VITE_HENROYADO_LODGING_URL=/data/shikoku-henroyado-lodging.pmtiles
VITE_MIN88_LODGING_URL=/data/shikoku-min88-lodging.pmtiles

# Mizutani Henro Guide Map PMTiles. Empty to disable.
VITE_MIZUTANI_HENRO_URL=/data/shikoku-mizutani-henro.pmtiles

# 四国遍路世界遺産登録推進協議会 (88sekaiisan.org) guiding-line source edges
# GeoJSON (from output/sekaiisan-henro-review/source-edges.geojson). This is
# raw official source linework, NOT inferred corridors / navigation. Empty to
# disable.
VITE_SEKAIISAN_HENRO_URL=/data/shikoku-sekaiisan-henro.geojson

# 世界遺産 day-plan 候選結果（output/sekaiisan-henro-plan.geojson，由
# `python3 -m sekaiisan_henro plan` 產生）。planned_route LineString +
# waypoint Points，僅顯示 Python 最近一次輸出，非互動計算。Empty to disable.
VITE_PLAN_URL=/data/sekaiisan-henro-plan.geojson

# 互動規劃用的 compact routing graph（output/sekaiisan-henro-plan-graph.json，
# 由 `python3 -m sekaiisan_henro export-plan-graph` 產生；traversal_edges +
# synthetic_joins + nodes）。規劃模式啟用時瀏覽器直接抓這份在本地跑 Dijkstra。
# Empty to disable the interactive planner.
VITE_PLAN_GRAPH_URL=/data/sekaiisan-henro-plan-graph.json

# 歩き遍路 routes (arukihenro) normalized JSON (from output/arukihenro-routes.json,
# ~5MB, fetched inline as GeoJSON). These are ohenro.jp personal hand-drawn +
# Google navigation reference lines: a spatial reference only, NOT official and
# NOT a navigation guarantee. Empty to disable.
VITE_ARUKIHENRO_URL=/data/arukihenro-routes.json

# Henro Helper (com.henrohelper100.app) routes GeoJSON extracted from the APK
# (output/henro-helper-routes/henro-helper-routes.geojson). Layers preserve the
# app's own classification (road/trail/special/connection/itinerary). Empty to
# disable.
VITE_HENRO_HELPER_URL=/data/henro-helper-routes.geojson

# Henro Helper POI markers (temples/toilets/convenience/rest areas/accommodations/
# okunoin-bangai/labels ...) GeoJSON (output/henro-helper-routes/
# henro-helper-pois.geojson). Per-kind circle layers (z8+) + labels for named
# kinds (z11+). Empty to disable.
VITE_HENRO_HELPER_POIS_URL=/data/henro-helper-pois.geojson

# OHenro 88 (com.sallyzzz.ohenroapp) routes GeoJSON extracted from the APK
# (output/ohenro88-routes/ohenro88-routes.geojson). Per-route selector groups
# by route_type (main/skip/bekkaku/bekkaku_extra/extra). Empty to disable.
VITE_OHENRO88_URL=/data/ohenro88-routes.geojson

# 遍路のあかり+ (jp.co.yonden.henronoakari) walking route GeoJSON extracted
# from the web app bundle (output/ohenro-no-akari-routes/
# henro-no-akari-route.geojson). 319 road-level LineString segments forming
# the single continuous walking route. Empty to disable.
VITE_OHENRO_NO_AKARI_URL=/data/henro-no-akari-routes.geojson

# Elevation visualization PMTiles. Empty to disable (basemap + Henro still load).
VITE_CONTOURS_URL=/data/shikoku-contours.pmtiles
VITE_TERRAIN_URL=/data/shikoku-terrain.pmtiles

# Local phase-2b sprite / glyph assets (override the remote defaults in the
# generated style.json). These default to public/data/app-map-assets (linked
# from output/app-map-assets). The glyph URL must use the {fontstack} token
# (MapLibre GL JS replaces it with the layer's text-font name).
VITE_SPRITE_URL=/data/app-map-assets/sprites/light
VITE_GLYPHS_URL=/data/app-map-assets/fonts/{fontstack}/{range}.pbf
