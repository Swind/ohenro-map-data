# Build artifacts
target/

# Large generated binaries (small JSON outputs under output/ can be tracked)
*.pmtiles
*.osm.pbf

# GSI DEM pipeline intermediate + output (re-buildable, see gsi-dem/README.md)
work/
*.sqlite
*.tile
*.bin

# Henroyado raw HTML snapshot (re-fetchable via `python3 -m henroyado fetch`)
source/henroyado.html
source/henroyado-google-maps/

# min88 lodging raw HTML archive and Google Maps response cache
source/min88-lodging/

# Shikoku Nature Trail raw archive (re-fetchable via
# `python3 -m shikoku_nature_trail crawl-all`); keep the crawler code tracked
source/shikoku-nature-trail/
# Deterministic Phase 2 dataset (~9.6MB, rebuilt from the raw archive)
output/shikoku-nature-trail.json
# Route profile samples are large but can be rebuilt from the GeoJSON + DEM SQLite.
output/shikoku-nature-trail-elevation.json

# Phase 2b generated offline assets (rebuilt by scripts/build-app-map-assets.py)
output/app-map-assets/

# Mizutani Henro Guide Map raw KML snapshots and derived personal-use data
source/mizutani-henro-map/
source/omotenashi-henro-inspection/
source/88sekaiisan-henro/
output/mizutani-henro-map.json
output/mizutani-henro-routes.geojson
output/mizutani-henro-pois.geojson
output/mizutani-henro-report.json
output/mizutani-henro-style-inventory.json
output/mizutani-henro-update-report.json
# Generated downloadable route-pack artifacts (first consumer: Mizutani, personal-use)
output/route-packs/
# 88sekaiisan Phase 1 normalization + Phase 2A inventory + Phase 2B graph + Phase 2C proximity + Phase 3 anchors + Phase 4 sections + Phase 4b corridors (re-built from archive)
output/sekaiisan-henro-normalized.json
output/sekaiisan-henro-topology-inventory.json
output/sekaiisan-henro-graph.json
output/sekaiisan-henro-graph-proximity.json
output/sekaiisan-henro-graph-anchors.json
output/sekaiisan-henro-temple-sections.json
output/sekaiisan-henro-section-corridors.json
output/sekaiisan-henro-section-corridor-edges.geojson
output/sekaiisan-henro-arukihenro-attribution.json
output/sekaiisan-henro-arukihenro-attribution-traversal.json
# 88sekaiisan QGIS review-pack / report exporter (rebuilt by build-review-pack)
output/sekaiisan-henro-review/

# Arukihenro walking-route pages and Google My Maps KML archive
source/arukihenro-routes/

# Henro Helper APK reverse-engineering artifacts (rebuilt from the XAPK via
# reference/ohenro-helper/extract_routes.py). Keep only the extractor tracked.
/reference/ohenro-helper/*
!/reference/ohenro-helper/extract_routes.py
# Extracted route GeoJSON (rebuilt by extract_routes.py)
output/henro-helper-routes/

# OHenro 88 APK reverse-engineering artifacts (rebuilt from the XAPK via
# reference/ohenro-88/build_reference.py). Keep only the builder tracked.
/reference/ohenro-88/*
!/reference/ohenro-88/build_reference.py
# Extracted route reference (rebuilt by build_reference.py)
output/ohenro88-routes/

# Henro no Akari (Yonden) web route reference artifacts (XAPK + bundle snapshot
# re-fetchable via reference/ohenro-no-akari/build_web_reference.py).
# Keep only the builder tracked.
/reference/ohenro-no-akari/*
!/reference/ohenro-no-akari/build_web_reference.py
# Extracted web route reference (rebuilt by build_web_reference.py)
output/ohenro-no-akari-routes/

# GSI DEM source ZIPs (20k+ meshes, 1.8GB, re-downloadable from GSI)
source/GSI/

# Python
__pycache__/
*.pyc

# OS
.DS_Store
